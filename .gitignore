# the check's dependencies
node_modules/

# generated by xcodegen from ios/project.yml, and by nothing else
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/Leatherbound/Info.plist

# the archive the workflow builds
build/
*.ipa
*.xcarchive/

# of the font sources, only the open-licensed ones are kept: a face that may not
# be passed on does not belong in a public repository
fonts-i-like/*
!fonts-i-like/Patrick_Hand.zip
!fonts-i-like/Architects_Daughter,Coming_Soon.zip
!fonts-i-like/Frijole.zip

# this editor's own workspace marker
.freebuff/

# xcode and the finder leave these behind
xcuserdata/
DerivedData/
.DS_Store
